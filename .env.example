# Aucune valeur secrète réelle ici. Copier vers .env et renseigner localement.
APP_ENV=dev-cpu
JWT_SECRET=CHANGE_ME
APPROVAL_HMAC_SECRET=CHANGE_ME
DATABASE_URL=sqlite:///./data/maintidoc.db
QDRANT_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
VLM_BACKEND=fake
DEVICE=auto
EMBEDDING_BACKEND=hashing
MAX_MODEL_CALLS=6
MAX_MCP_CALLS=3
MAX_PIPELINE_SECONDS=60
MAX_IMAGE_BYTES=8000000
# Docker Compose (démo complète)
POSTGRES_USER=maintidoc
POSTGRES_PASSWORD=CHANGE_ME
# DATABASE_URL=postgresql+psycopg2://maintidoc:CHANGE_ME@localhost:5432/maintidoc
# MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=maintidoc-corpus
